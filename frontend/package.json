{
  "name": "composer",
  "private": true,
  "version": "1.45.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:component",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project browser",
    "test:component:watch": "vitest --project browser",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "biome lint --write . && biome format --write .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "knip:production": "knip --production",
    "jscpd": "jscpd",
    "doctor": "npx --yes react-doctor@latest ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@tabler/icons-react": "^3.48.0",
    "@wavesurfer/react": "^1.0.12",
    "clsx": "^2.1.1",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "node-diff3": "^3.2.1",
    "obscenity": "^0.4.6",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.15",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "wavesurfer.js": "^7.12.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "jscpd": "^5.3.2",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "playwright": "^1.63.0",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.0",
    "vite": "^6.4.3",
    "vite-react-ssg": "0.9.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.3.0"
  }
}
