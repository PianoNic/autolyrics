# Copy to .env and fill in. Never commit .env.

# DeepSeek API (https://platform.deepseek.com) – used for the final text clean-up only.
AUTOLYRICS_DEEPSEEK_API_KEY=
# AUTOLYRICS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AUTOLYRICS_DEEPSEEK_MODEL=deepseek-chat

# Spotify Web API app (https://developer.spotify.com/dashboard) – for Spotify links.
AUTOLYRICS_SPOTIFY_CLIENT_ID=
AUTOLYRICS_SPOTIFY_CLIENT_SECRET=
